[Unit]
Description=Mall4j monolith API
After=network-online.target mysql.service redis-server.service
Wants=network-online.target

[Service]
Type=simple
User=linux1
WorkingDirectory=/home/linux1/apps/mall4j
ExecStart=/usr/bin/java -jar /home/linux1/apps/mall4j/yami-shop-admin/target/yami-shop-admin-0.0.1-SNAPSHOT.jar --spring.datasource.username=mall4j --spring.datasource.password=mall4j_local --server.port=8080
Restart=on-failure
RestartSec=5
SuccessExitStatus=143

[Install]
WantedBy=multi-user.target
