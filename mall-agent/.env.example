# From the mall-agent directory, run: cp .env.example .env
# Replace every sample value in .env with your own local settings. Keep .env
# out of Git; this example intentionally contains no real credentials.

# LLM provider (OpenAI-compatible API)
MODEL_NAME=your-model-name
BASE_URL=https://your-provider.example/v1
API_KEY=replace-with-your-llm-api-key

# Search provider
TAVILY_API_KEY=replace-with-your-tavily-api-key

# Redis services
REDIS_URL=redis://localhost:6379/0
LANGGRAPH_REDIS_URL=redis://localhost:6379/0

# Java mall service integration. Set the same MALL_AGENT_AUTH_TOKEN in the
# Java admin service environment and this Python service environment.
JAVA_AUTH_INTROSPECT_URL=http://127.0.0.1:18080/internal/auth/introspect
MALL_AGENT_AUTH_TOKEN=replace-with-a-long-random-shared-secret
MCP_SERVER_URL=http://127.0.0.1:18081/mcp

# Optional: access token used only by app/mcp/test.py for local smoke tests
TEST_MALL_TOKEN=replace-with-a-test-user-access-token
